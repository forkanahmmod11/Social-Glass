{
  "name": "CountryPricing",
  "type": "object",
  "properties": {
    "country": {
      "type": "string",
      "description": "Country name"
    },
    "country_code": {
      "type": "string",
      "description": "ISO 2-letter country code (e.g. BD, US, IN)"
    },
    "currency": {
      "type": "string",
      "description": "Currency code e.g. BDT, USD, INR"
    },
    "symbol": {
      "type": "string",
      "description": "Currency symbol e.g. \u09f3, $, \u20b9"
    },
    "payment_methods": {
      "type": "string",
      "description": "JSON array of payment method keys"
    },
    "price_multiplier": {
      "type": "number",
      "default": 1,
      "description": "Multiplier applied to base BDT prices (e.g. 0.0091 for USD)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "country",
    "country_code",
    "currency",
    "symbol"
  ]
}